{
  "name": "forbid-commands",
  "version": "0.1.0",
  "description": "Pi extension that blocks destructive commands using dcg + custom patterns.",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "bin": {
    "forbid-commands": "./dist/cli.js"
  },
  "scripts": {
    "build": "npx tsc --outDir dist",
    "check": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "forbid-commands",
    "destructive-commands",
    "dcg"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.0"
  },
  "dependencies": {
    "web-tree-sitter": "^0.26.11"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
